{
  "name": "@cloud-trigger/persistence-postgres",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@cloud-trigger/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@cloud-trigger/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "pnpm --filter @cloud-trigger/persistence-sql build && drizzle-kit generate"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "dependencies": {
    "@cloud-trigger/core": "workspace:*",
    "@cloud-trigger/persistence-sql": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloud-trigger/testing": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:"
  }
}
