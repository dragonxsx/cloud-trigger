    "@cloud-trigger/testing": "workspace:*",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7",
    "@orpc/openapi-client": "1.15.7",
    "@testcontainers/mongodb": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "vitest": "5.0.5"
