{
  "name": "@cloud-trigger/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "reset-admin": "node --env-file-if-exists=.env dist/cli.js reset-admin",
    "reseal-secrets": "node --env-file-if-exists=.env dist/cli.js reseal-secrets"
  },
  "dependencies": {
    "@cloud-trigger/api-contract": "workspace:*",
    "@cloud-trigger/core": "workspace:*",
    "@cloud-trigger/engine": "workspace:*",
    "@cloud-trigger/persistence-mongo": "workspace:*",
    "@cloud-trigger/persistence-postgres": "workspace:*",
    "@cloud-trigger/persistence-sqlite": "workspace:*",
    "@cloud-trigger/providers-aws": "workspace:*",
    "@cloud-trigger/providers-builtin": "workspace:*",
    "@cloud-trigger/providers-grpc": "workspace:*",
    "@cloud-trigger/providers-kafka": "workspace:*",
    "@cloud-trigger/providers-nats": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/serve-static": "12.0.0",
    "@noble/ciphers": "2.4.0",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@orpc/json-schema": "1.15.7",
    "@orpc/nest": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/zod": "1.15.7",
    "@prometheus-io/client": "0.16.1",
    "@scalar/nestjs-api-reference": "1.2.29",
    "badge-maker": "6.0.0",
    "commander": "15.0.0",
    "express": "5.3.0",
    "ical-generator": "11.1.2",
    "jose": "6.2.12",
