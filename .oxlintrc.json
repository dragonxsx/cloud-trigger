{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsx-a11y", "node", "promise", "react", "typescript", "unicorn", "vitest"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["**/.turbo/**", "**/coverage/**", "**/dist/**", "**/node_modules/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/consistent-type-imports": "error",
    "eslint/no-console": "warn",
    "unicorn/no-null": "off",
    "import/no-cycle": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_id", "_unsafeUnwrap", "_unsafeUnwrapErr", "__errors"],
        "allowAfterThis": true
      }
    ],
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["reflect-metadata", "**/*.css", "@fontsource-variable/*"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "ignoreElements": ["td", "tr"]
      }
    ],
    "eslint/curly": ["error", "all"],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      }
    ]
  }
}
