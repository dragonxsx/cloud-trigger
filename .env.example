# Copy to apps/server/.env for `pnpm --filter @cloud-trigger/server dev`.
DB_DRIVER=mongo              # mongo | postgres | sqlite
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# POSTGRES_URL=postgres://cloud:cloud@localhost:5432/cloud_trigger
# POSTGRES_MAX_CONNECTIONS=10
# SQLITE_PATH=./data/cloud-trigger.db   # single node only; requires APP_ROLE=all
MONGO_DB=cloud_trigger
APP_ROLE=all                 # all | comma list of api,scheduler,worker,consumer
PORT=8080
LOG_LEVEL=info

# Auth: disable only for local development.
AUTH_DISABLED=true
# API_KEYS=ci:<sha256 hex of key>:write,viewer:<sha256>:read
# OIDC_ISSUER=https://idp.example.com/realms/main
# OIDC_AUDIENCE=cloud-trigger
# Token scopes like cloud-trigger:write map to API scopes; tokens with none get OIDC_DEFAULT_SCOPES.
# OIDC_SCOPE_PREFIX=cloud-trigger:
# Web UI SSO (authorization code + PKCE) with a public client. Local Keycloak:
#   docker compose -f deploy/docker-compose.yml --profile auth up -d   (user demo / demo)
# OIDC_ISSUER=http://localhost:8081/realms/cloud-trigger
# OIDC_AUDIENCE=cloud-trigger
# OIDC_CLIENT_ID=cloud-trigger-web
# OIDC_UI_SCOPE=openid profile cloud-trigger:read cloud-trigger:write
# Read-only wallboards: unauthenticated visitors get these scopes.
# ANONYMOUS_SCOPES=read

# Status badges (/badges/jobs/<id>.svg) need the read scope unless public.
# BADGES_PUBLIC=false
# Signs /calendar.ics subscription tokens (POST /api/calendar/token). At least 32 characters.
# CALENDAR_TOKEN_SECRET=
# PUBLIC_URL=https://cloud-trigger.example.com

# Secrets referenced as {{secret:NAME}} in job configs:
# CT_SECRET_PARTNER_TOKEN=...
# SECRETS_DIR=/var/run/secrets/cloud-trigger

# WORKER_CONCURRENCY=16
# LEASE_MS=30000

# DECISION_RETENTION_DAYS=14     # scheduler decisions kept for the "why didn't it run?" explainer
# SLA_INTERVAL_MS=5000          # how often scheduler replicas check for late runs

# Notifications are delivered by worker replicas through a Mongo outbox.
# NOTIFY_TIMEOUT_MS=10000
# NOTIFY_MAX_ATTEMPTS=5
# NOTIFY_POLL_MS=1000

# Event triggers. APP_ROLE=all includes `consumer`, which runs queue consumers (sqs, kafka, nats).
# CONSUMER_INTERVAL_MS=5000     # how often consumers re-check event-source jobs and renew leases
# CONSUMER_LEASE_MS=30000       # exclusive sources (SQS) are polled by one replica at a time
# Inbound webhooks: POST /hooks/<jobId>/<token>
# WEBHOOK_MAX_PER_SECOND=20     # per-job default when the trigger sets no rateLimit
# WEBHOOK_MAX_BODY_BYTES=262144

# OpenTelemetry: export one span per run attempt; traceparent is forwarded to every target.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=cloud-trigger
