# Copy to apps/server/.env for `pnpm --filter @cloud-trigger/server dev`.
DB_DRIVER=mongo              # mongo | postgres | sqlite; inferred from MONGO_URI or POSTGRES_URL when unset
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# POSTGRES_URL=postgres://cloud:cloud@localhost:5432/cloud_trigger
# POSTGRES_MAX_CONNECTIONS=10
# SQLITE_PATH=./data/cloud-trigger.db   # single node only; requires APP_ROLE=all
MONGO_DB=cloud_trigger
APP_ROLE=all                 # all | comma list of api,scheduler,worker,consumer
PORT=8080
LOG_LEVEL=info

# Required. Encrypts secret provider fields and the session secret in the database. Back it up:
# losing it makes stored secrets unrecoverable. Generate with `openssl rand -base64 32`.
DATA_ENCRYPTION_KEY=
# Rotation: set a new key above, list the old one here, then run
# `pnpm --filter @cloud-trigger/server reseal-secrets`. Keep the old key until outbox retention passes.
# DATA_ENCRYPTION_PREVIOUS_KEYS=<old key>,<older key>

# Sign-in is configured in the UI. First run logs a one-time /setup token; preset it with multiple replicas.
# SETUP_TOKEN=<at least 16 characters>
# Locked out? `pnpm --filter @cloud-trigger/server reset-admin <username>` prints a new password.

# Status badges (/badges/jobs/<id>.svg) need the read scope unless public.
# BADGES_PUBLIC=false
# Signs /calendar.ics subscription tokens (POST /api/calendar/token). At least 32 characters.
# CALENDAR_TOKEN_SECRET=
# PUBLIC_URL=https://cloud-trigger.example.com

# OpenAPI imports fetch spec URLs only from public addresses; set true to allow internal hosts.
# OPENAPI_FETCH_ALLOW_PRIVATE=false

# Secrets referenced as {{secret:NAME}} in job configs:
# CT_SECRET_PARTNER_TOKEN=...
# SECRETS_DIR=/var/run/secrets/cloud-trigger

# WORKER_CONCURRENCY=16
# LEASE_MS=30000

# RUN_RETENTION_DAYS=30         # finished runs and workflow runs (approval decisions included)
# METRICS_RETENTION_DAYS=90
# DECISION_RETENTION_DAYS=14     # scheduler decisions kept for the "why didn't it run?" explainer
# SLA_INTERVAL_MS=5000          # how often scheduler replicas check for late runs

# Notifications are delivered by worker replicas through a Mongo outbox.
# NOTIFY_TIMEOUT_MS=10000
# NOTIFY_MAX_ATTEMPTS=5
# NOTIFY_POLL_MS=1000

# Event triggers. APP_ROLE=all includes `consumer`, which runs queue consumers (sqs, kafka, nats).
# CONSUMER_INTERVAL_MS=5000     # how often consumers re-check event-source jobs and renew leases
# CONSUMER_LEASE_MS=30000       # exclusive sources (SQS) are polled by one replica at a time
# Inbound webhooks: POST /hooks/<jobId>/<token>
# WEBHOOK_MAX_PER_SECOND=20     # per-job default when the trigger sets no rateLimit
# WEBHOOK_MAX_BODY_BYTES=262144

# OpenTelemetry: traces (HTTP, Express, undici, MongoDB and one span per run attempt; traceparent is
# forwarded to every target), metrics and logs over OTLP. Nothing is exported until an endpoint is set;
# /metrics (Prometheus format) is served either way. Standard OTEL_* variables apply.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf         # http/json or grpc (port 4317)
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=               # per-signal override, also _METRICS_ and _LOGS_
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>   # secret; vendor auth
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=               # per-signal override (full URL), also _METRICS_ and _LOGS_
# OTEL_TRACES_EXPORTER=otlp                         # otlp, console or none; same for METRICS and LOGS (otlp needs an endpoint)
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_SERVICE_NAME=cloud-trigger                   # or service.name in OTEL_RESOURCE_ATTRIBUTES
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_NODE_DISABLED_INSTRUMENTATIONS=mongodb       # or OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express,undici
# OTEL_SDK_DISABLED=true                            # no instrumentation or export; /metrics keeps engine and runtime metrics
